<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: back up / transfer only Luma's preferences (layout + settings). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="luma_app_cache.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="luma_app_cache.xml" />
    </device-transfer>
</data-extraction-rules>

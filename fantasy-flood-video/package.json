{
  "name": "fantasy-flood-video",
  "version": "1.0.0",
  "private": true,
  "description": "1DEX1 — как я затопил весь мир с FantasyVisual (Remotion + three.js)",
  "scripts": {
    "sounds": "node scripts/fetch-sounds.mjs",
    "dev": "npm run sounds && remotion studio",
    "render": "npm run sounds && remotion render FloodVideo out/1dex1-flood.mp4",
    "render:admin": "npm run sounds && remotion render AdminChat out/1dex1-admin-chat.mp4",
    "render:nesveti": "remotion render NeSveti out/ne-sveti.mp4",
    "render:nesveti2": "remotion render NeSveti2 out/ne-sveti-2.mp4",
    "sfx:nesveti": "python3 scripts/make-sunflower-sfx.py",
    "still": "remotion still FloodVideo out/frame.png",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "@remotion/cli": "4.0.542",
    "@remotion/three": "4.0.542",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "4.0.542",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.187.0",
    "typescript": "^5.6.0"
  }
}

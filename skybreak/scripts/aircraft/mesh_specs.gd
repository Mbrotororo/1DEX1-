extends RefCounted
## Параметры силуэта для каждого самолёта. Размеры масштабируются от def.shape:
## R = fuselage_radius, L = length, semi = span / 2, c = chord.
##
## body: [t, w, ht, hb, y, nt, nb] — t от носа (0) к хвосту (1); w, ht, hb, y в долях R;
##       nt/nb — показатель суперэллипса верхней и нижней половины (2 = эллипс, 4 = почти квадрат).
## canopy: z0/z1 — доли L от shape.cockpit_z; w, h — в долях R.
## wing: plan "trap" | "delta" | "diamond"; y — в долях R; углы в градусах.
## stab/fin: t — положение передней кромки корня; h, chord у киля — в долях L; у стабилизатора chord — от c.
## gear: xs — доля полуразмаха; t — положение по длине; r — радиус колеса в метрах.


static func spec_for(def: Dictionary) -> Dictionary:
	var sh: Dictionary = def.get("shape", {})
	var engines: String = sh.get("engines", "single_jet")
	var s: Dictionary = _defaults(engines, String(sh.get("wing_type", "straight")), String(sh.get("tail", "single")))
	var ov: Dictionary = _overrides().get(String(def.get("id", "")), {})
	for k in ov:
		if s.has(k) and s[k] is Dictionary and ov[k] is Dictionary and not (ov[k] as Dictionary).is_empty():
			var d: Dictionary = (s[k] as Dictionary).duplicate(true)
			d.merge(ov[k], true)
			s[k] = d
		else:
			s[k] = ov[k]
	return s



# ===== Обязательно =====
# Токен бота от @BotFather (никому не показывай и не выкладывай!)
BOT_TOKEN=123456789:ВСТАВЬ_СЮДА_ТОКЕН

# ===== Доступ =====
# ID пользователей Telegram через запятую, кому можно пользоваться ботом.
# Пусто = любой, кто подключит бота к своему аккаунту. Свой ID бот покажет по /start.
ALLOWED_USER_IDS=

# ===== Команды =====
# Максимум сообщений в одном .spam
SPAM_LIMIT=100
# Пауза между сообщениями спама в секундах (меньше = быстрее упрёшься в лимит Telegram)
SPAM_DELAY=0.5
# Пауза между кадрами анимации .love в секундах
LOVE_FRAME_DELAY=0.7

# ===== Кэш сообщений (нужен для «было -> стало» при редактировании) =====
CACHE_DAYS=7

# ===== .link (скачивание видео) =====
# 50 МБ — лимит Telegram на видео от ботов
MAX_VIDEO_MB=50
MAX_VIDEO_MINUTES=20
# 1 = TikTok в 1080p (кодек HEVC), 0 = 540p H.264 (играет на любом телефоне)
TIKTOK_HD=0
# Путь к файлу cookies YouTube (формат Netscape). Нужен, если YouTube пишет
# «Sign in to confirm you're not a bot» — обычно на серверах (VPS), дома не нужен.
YTDLP_COOKIES=
# JS-движок для YouTube. Пусто = deno, который ставится из requirements.txt.
# Можно: node (нужна версия 22+) или deno:/путь/к/deno
YTDLP_JS_RUNTIME=

# ===== Прочее =====
# 1 = при запуске обновлять описание и меню команд бота
SET_BOT_PROFILE=1
LOG_LEVEL=INFO

# Скопируй этот файл в server/.env и впиши свои значения. Файл .env не попадает в git.

# Порт сайта
PORT=8080

# Почта, с которой уходят коды подтверждения (SMTP по SSL, порт 465).
# Яндекс: smtp.yandex.ru, Mail.ru: smtp.mail.ru, Gmail: smtp.gmail.com.
# Пароль — не от почты, а «пароль приложения» из настроек безопасности почты.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="1DEX1 SHOP <shop@example.com>"

# 1 — сайт открыт по https (cookie входа только по защищённому соединению)
COOKIE_SECURE=0

# 1 — сервер стоит за прокси (nginx, Render и т.п.): брать адрес посетителя из X-Forwarded-For
TRUST_PROXY=0

# Где лежит база (по умолчанию server/data/shop.db)
# DB_PATH=

# Уведомления о покупках в Telegram (см. server/telegram.js):
# токен бота от @BotFather и номер чата (npm run admin -- telegram chatid)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
